# ===================== MySQL (дані надає GoIT) =====================
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=olympic_dataset
# БД для запису результату (якщо порожньо — використовується MYSQL_DB)
MYSQL_OUTPUT_DB=
# Таблиця для результату стриму (додайте своє ім'я, щоб не перетертися з іншими)
MYSQL_OUTPUT_TABLE=yourname_athlete_enriched_avg

# ===================== Kafka (дані надає GoIT) =====================
KAFKA_BOOTSTRAP_SERVERS=your_kafka_host:9092
# PLAINTEXT для локального Kafka, SASL_PLAINTEXT для сервера з логіном
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=your_kafka_user
KAFKA_PASSWORD=your_kafka_password
# Префікс топіків (ваше ім'я): yourname_athlete_event_results, yourname_athlete_enriched_agg
KAFKA_TOPIC_PREFIX=yourname

# ===================== Spark =====================
CHECKPOINT_DIR=checkpoint
